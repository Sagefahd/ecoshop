# Copy this file to .env and fill in real values.
# Never commit your actual .env file.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Arkesel SMS (phone OTP) ---
# Get an API key at https://arkesel.com after creating an account.
# If left blank, OTP codes are printed to the console/log instead of sent (dev mode).
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=EcoShop

# --- Paystack (card / mobile money payments) ---
# Get test keys from your Paystack dashboard: https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# --- Google sign-in ---
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Apple sign-in ---
# Requires an Apple Developer account: https://developer.apple.com/sign-in-with-apple/
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# --- Support ---
# The WhatsApp number (no + or spaces) the floating WhatsApp button links to.
WHATSAPP_SUPPORT_NUMBER=233200000000
