# Copy this file to .env and fill in real values.
# Never commit your actual .env file.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Nalo Solutions (SMS OTP + Mobile Money payment) ---
# Get credentials at https://nalosolutions.com after creating an account.
# If left blank, OTP codes print to the console and payment requests are
# simulated in the console instead of sent (dev mode).
NALO_SMS_USERNAME=
NALO_SMS_PASSWORD=
NALO_SMS_SENDER_ID=EcoShop

NALO_PAYMENT_USERNAME=
NALO_PAYMENT_PASSWORD=
NALO_MERCHANT_ID=

# --- Google sign-in ---
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Apple sign-in ---
# Requires an Apple Developer account: https://developer.apple.com/sign-in-with-apple/
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# --- Support ---
# The WhatsApp number (no + or spaces) the floating WhatsApp button links to.
WHATSAPP_SUPPORT_NUMBER=233200000000
